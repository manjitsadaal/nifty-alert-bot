# Copy this file to .env and fill in your values. Never share .env.

# Kite Connect Personal app (free) — developers.kite.trade > My Apps
KITE_API_KEY=
KITE_API_SECRET=
# Must match the app's Redirect URL: http://127.0.0.1:8765/callback
KITE_REDIRECT_PORT=8765

# Telegram — token + username from @BotFather; chat id from @userinfobot (or: python run.py chatid)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_USERNAME=

# Tuning (defaults are fine)
ALERTS_EACH_SIDE=4
MERGE_DISTANCE=15
MAX_DISTANCE_PCT=2.0
BREAK_BUFFER=5
