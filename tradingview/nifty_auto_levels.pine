//@version=6
// Nifty Auto Levels — draws today's support/resistance automatically, removes old
// ones each new day, marks the opening range, and fires alerts on 15m price action.
// Levels: previous day H/L/C, classic pivots, CPR, Camarilla, previous week H/L,
// round numbers. Nearby levels merge into zones; more sources = stronger (more ★).
// Not trade advice.
indicator("Nifty Auto Levels", shorttitle = "AutoLevels", overlay = true,
     max_lines_count = 200, max_labels_count = 300, max_boxes_count = 100)

// ───────────────────────────── Inputs
grpL = "Levels"
showPrevDay = input.bool(true, "Previous day high / low / close", group = grpL)
showPivots  = input.bool(true, "Classic pivots (P, R1–R3, S1–S3)", group = grpL)
showCPR     = input.bool(true, "CPR (TC / BC)", group = grpL)
showCam     = input.bool(true, "Camarilla (H3, H4, L3, L4)", group = grpL)
showWeek    = input.bool(true, "Previous week high / low", group = grpL)
showRound   = input.bool(true, "Round numbers", group = grpL)
roundStep   = input.int(100, "Round number step", minval = 10, group = grpL)
mergeDist   = input.float(15, "Merge levels closer than (points)", minval = 0, group = grpL)
maxDistPct  = input.float(1.5, "Only levels within % of today's open", minval = 0.1, group = grpL)
minScore    = input.int(3, "Minimum zone strength to draw", minval = 1, maxval = 10, group = grpL)

grpO = "Opening range"
showORB = input.bool(true, "Show opening range (ORB)", group = grpO)
orbSess = input.session("0915-0945", "Opening range session (IST)", group = grpO)

grpA = "Signals & alerts"
breakBuf    = input.float(5, "Break buffer (points)", minval = 0, group = grpA)
wickPct     = input.float(50, "Rejection wick, % of candle", minval = 10, maxval = 95, group = grpA)
showSignals = input.bool(false, "Show signal markers on chart", group = grpA)
tgChatId    = input.string("", "Telegram chat id (optional, for webhook)", group = grpA,
     tooltip = "Fill this only if you send alerts to Telegram via webhook. Leave empty for normal TradingView notifications.")

grpI = "Intraday levels (small timeframes)"
showVWAP    = input.bool(true, "VWAP + bands", group = grpI)
showBands   = input.bool(false, "VWAP bands", group = grpI)
bandMult    = input.float(1.0, "VWAP band (std dev)", minval = 0.1, step = 0.5, group = grpI)
showHL      = input.bool(false, "Today's high / low (live)", group = grpI)
showSwings  = input.bool(false, "Recent swing highs / lows", group = grpI)
swingLen    = input.int(5, "Swing strength (bars each side)", minval = 2, maxval = 20, group = grpI)
maxSwings   = input.int(2, "Swings to keep on each side", minval = 1, maxval = 6, group = grpI)
vwapAlerts  = input.bool(true, "Alert on VWAP cross", group = grpI)
swingAlerts = input.bool(true, "Alert on swing break", group = grpI)
swingCol    = input.color(#455a64, "Swing levels", group = grpI)
vwapCol     = input.color(#ff9800, "VWAP", group = grpI)

grpS = "Style"
resCol    = input.color(#d32f2f, "Resistance", group = grpS)
supCol    = input.color(#1565c0, "Support", group = grpS)
pivCol    = input.color(#f57c00, "Pivot / CPR", group = grpS)
orbCol    = input.color(#7b1fa2, "Opening range", group = grpS)
showTable = input.bool(true, "Info table", group = grpS)

// ───────────────────────────── Daily / weekly values (completed bars only: no repaint)
[pdh, pdl, pdc] = request.security(syminfo.tickerid, "D", [high[1], low[1], close[1]], lookahead = barmerge.lookahead_on)
[pwh, pwl]      = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = barmerge.lookahead_on)

pp  = (pdh + pdl + pdc) / 3
rng = pdh - pdl
r1  = 2 * pp - pdl
s1  = 2 * pp - pdh
r2  = pp + rng
s2  = pp - rng
r3  = pdh + 2 * (pp - pdl)
s3  = pdl - 2 * (pdh - pp)
bc0 = (pdh + pdl) / 2
tc0 = 2 * pp - bc0
tc  = math.max(tc0, bc0)
bc  = math.min(tc0, bc0)
cprWidth = (tc - bc) / pp * 100
h4 = pdc + rng * 1.1 / 2
h3 = pdc + rng * 1.1 / 4
l3 = pdc - rng * 1.1 / 4
l4 = pdc - rng * 1.1 / 2

// ───────────────────────────── State
var array<float>  zPrice = array.new<float>()
var array<float>  zLow   = array.new<float>()
var array<float>  zHigh  = array.new<float>()
var array<string> zName  = array.new<string>()
var array<int>    zScore = array.new<int>()
var array<bool>   zPiv   = array.new<bool>()
var array<line>   zLines = array.new<line>()
var array<box>    zBoxes = array.new<box>()
var array<label>  zLbls  = array.new<label>()
var array<string> fired  = array.new<string>()
var float dayOpen = na

addLevel(array<float> ps, array<string> ts, array<int> ws, float p, string t, int w, float ref) =>
    if not na(p) and not na(ref) and math.abs(p - ref) <= ref * maxDistPct / 100
        ps.push(p)
        ts.push(t)
        ws.push(w)

stars(int s) =>
    n = math.min(int(math.floor(s / 2)), 5)
    out = ""
    if n > 0
        for i = 1 to n
            out += "★"
    out

newDay = timeframe.change("D")

// ───────────────────────────── Build today's zones on the first bar of each day
if newDay
    dayOpen := open
    for l in zLines
        l.delete()
    for b in zBoxes
        b.delete()
    for lb in zLbls
        lb.delete()
    zLines.clear()
    zBoxes.clear()
    zLbls.clear()
    zPrice.clear()
    zLow.clear()
    zHigh.clear()
    zName.clear()
    zScore.clear()
    zPiv.clear()
    fired.clear()

    ps = array.new<float>()
    ts = array.new<string>()
    ws = array.new<int>()
    if showPrevDay
        addLevel(ps, ts, ws, pdh, "PDH", 3, dayOpen)
        addLevel(ps, ts, ws, pdl, "PDL", 3, dayOpen)
        addLevel(ps, ts, ws, pdc, "PDC", 2, dayOpen)
    if showPivots
        addLevel(ps, ts, ws, pp, "P", 2, dayOpen)
        addLevel(ps, ts, ws, r1, "R1", 2, dayOpen)
        addLevel(ps, ts, ws, s1, "S1", 2, dayOpen)
        addLevel(ps, ts, ws, r2, "R2", 1, dayOpen)
        addLevel(ps, ts, ws, s2, "S2", 1, dayOpen)
        addLevel(ps, ts, ws, r3, "R3", 1, dayOpen)
        addLevel(ps, ts, ws, s3, "S3", 1, dayOpen)
    if showCPR
        addLevel(ps, ts, ws, tc, "TC", 1, dayOpen)
        addLevel(ps, ts, ws, bc, "BC", 1, dayOpen)
    if showCam
        addLevel(ps, ts, ws, h4, "H4", 2, dayOpen)
        addLevel(ps, ts, ws, h3, "H3", 1, dayOpen)
        addLevel(ps, ts, ws, l3, "L3", 1, dayOpen)
        addLevel(ps, ts, ws, l4, "L4", 2, dayOpen)
    if showWeek
        addLevel(ps, ts, ws, pwh, "PWH", 3, dayOpen)
        addLevel(ps, ts, ws, pwl, "PWL", 3, dayOpen)
    if showRound
        base = math.floor(dayOpen / roundStep) * roundStep
        for k = -6 to 7
            rn = base + k * roundStep
            isBig = rn % 500 == 0
            addLevel(ps, ts, ws, rn, isBig ? "RND500" : "RND", isBig ? 2 : 1, dayOpen)

    if ps.size() > 0
        idx = ps.sort_indices(order.ascending)
        float cLow = na
        float cHigh = na
        string cName = ""
        int cScore = 0
        bool cPiv = false
        int bestW = 0
        float bestSum = 0.0
        int bestCnt = 0
        for j in idx
            p = ps.get(j)
            t = ts.get(j)
            w = ws.get(j)
            isPivTag = t == "P" or t == "TC" or t == "BC"
            if not na(cLow) and p - cHigh <= mergeDist and p - cLow <= 2 * mergeDist
                cHigh := p
                cName := str.contains("/" + cName + "/", "/" + t + "/") ? cName : cName + "/" + t
                cScore += w
                cPiv := cPiv or isPivTag
                if w > bestW
                    bestW := w
                    bestSum := p
                    bestCnt := 1
                else if w == bestW
                    bestSum += p
                    bestCnt += 1
            else
                if not na(cLow)
                    zPrice.push(bestSum / bestCnt)
                    zLow.push(cLow)
                    zHigh.push(cHigh)
                    zName.push(cName)
                    zScore.push(cScore)
                    zPiv.push(cPiv)
                cLow := p
                cHigh := p
                cName := t
                cScore := w
                cPiv := isPivTag
                bestW := w
                bestSum := p
                bestCnt := 1
        if not na(cLow)
            zPrice.push(bestSum / bestCnt)
            zLow.push(cLow)
            zHigh.push(cHigh)
            zName.push(cName)
            zScore.push(cScore)
            zPiv.push(cPiv)

    // Draw the zones that are strong enough
    if zPrice.size() > 0
        for i = 0 to zPrice.size() - 1
            sc = zScore.get(i)
            if sc >= minScore
                zp = zPrice.get(i)
                col = zPiv.get(i) ? pivCol : zp >= dayOpen ? resCol : supCol
                wd = math.min(1 + int(math.floor(sc / 3)), 4)
                zLines.push(line.new(bar_index, zp, bar_index + 1, zp, extend = extend.right, color = col, width = wd))
                if zHigh.get(i) - zLow.get(i) >= 2
                    zBoxes.push(box.new(bar_index, zHigh.get(i), bar_index + 1, zLow.get(i), extend = extend.right,
                         border_color = color.new(col, 100), bgcolor = color.new(col, 90)))
                parts = str.split(zName.get(i), "/")
                shortName = parts.size() > 2 ? parts.get(0) + "/" + parts.get(1) : zName.get(i)
                txt = str.tostring(zp, "#") + " " + shortName + " " + stars(sc)
                // Filled tag at the right edge so the text never sits on top of the line
                zLbls.push(label.new(bar_index, zp, txt, style = label.style_label_left, color = col,
                     textcolor = color.white, size = size.small))

// Keep labels at the right edge of the chart
if barstate.islast
    for lb in zLbls
        lb.set_x(bar_index + 4)

// ───────────────────────────── Opening range
inOrb = not na(time(timeframe.period, orbSess, "Asia/Kolkata"))
var float orH = na
var float orL = na
var line orHLine = na
var line orLLine = na
var label orHLbl = na
var label orLLbl = na
if newDay
    orH := na
    orL := na
if inOrb and timeframe.isintraday
    orH := na(orH) ? high : math.max(orH, high)
    orL := na(orL) ? low : math.min(orL, low)
orbDone = timeframe.isintraday and not inOrb and inOrb[1]
if showORB and orbDone and not na(orH) and timeframe.in_seconds() <= 900
    orHLine := line.new(bar_index, orH, bar_index + 1, orH, extend = extend.right, color = color.new(orbCol, 40), style = line.style_dashed)
    orLLine := line.new(bar_index, orL, bar_index + 1, orL, extend = extend.right, color = color.new(orbCol, 40), style = line.style_dashed)
    orHLbl := label.new(bar_index, orH, "ORB " + str.tostring(orH, "#"), style = label.style_label_lower_left,
         color = orbCol, textcolor = color.white, size = size.tiny)
    orLLbl := label.new(bar_index, orL, "ORB " + str.tostring(orL, "#"), style = label.style_label_upper_left,
         color = orbCol, textcolor = color.white, size = size.tiny)
if newDay
    orHLine.delete()
    orLLine.delete()
    orHLbl.delete()
    orLLbl.delete()

// ───────────────────────────── Signals (on closed candles, intraday charts only)
fmt(float x) => str.tostring(x, "#")

sendAlert(string key, string msg) =>
    if not fired.includes(key)
        fired.push(key)
        full = "NIFTY " + timeframe.period + "m · " + msg + " · close " + fmt(close)
        alert(tgChatId == "" ? full : "{\"chat_id\": \"" + tgChatId + "\", \"text\": \"" + full + "\"}", alert.freq_once_per_bar_close)
        true
    else
        false

if barstate.isconfirmed and timeframe.isintraday and zPrice.size() > 0
    candle = math.max(high - low, syminfo.mintick)
    upperWick = high - math.max(open, close)
    lowerWick = math.min(open, close) - low
    for i = 0 to zPrice.size() - 1
        if zScore.get(i) >= minScore
            zl = zLow.get(i)
            zh = zHigh.get(i)
            nm = fmt(zPrice.get(i)) + " [" + zName.get(i) + "]"
            if close[1] <= zh and close > zh + breakBuf
                if sendAlert("BU" + str.tostring(i), "BREAK ABOVE " + nm) and showSignals
                    label.new(bar_index, low, "▲ " + fmt(zPrice.get(i)), style = label.style_label_up, color = color.new(#26a69a, 0), textcolor = color.white, size = size.tiny)
            else if close[1] >= zl and close < zl - breakBuf
                if sendAlert("BD" + str.tostring(i), "BREAK BELOW " + nm) and showSignals
                    label.new(bar_index, high, "▼ " + fmt(zPrice.get(i)), style = label.style_label_down, color = color.new(#ef5350, 0), textcolor = color.white, size = size.tiny)
            if high >= zl and close < zl and upperWick / candle * 100 >= wickPct
                if sendAlert("RD" + str.tostring(i), "REJECTED at " + nm + " (sellers)") and showSignals
                    label.new(bar_index, high, "R", style = label.style_label_down, color = color.new(#ef5350, 30), textcolor = color.white, size = size.tiny)
            if low <= zh and close > zh and lowerWick / candle * 100 >= wickPct
                if sendAlert("RU" + str.tostring(i), "DEFENDED at " + nm + " (buyers)") and showSignals
                    label.new(bar_index, low, "D", style = label.style_label_up, color = color.new(#26a69a, 30), textcolor = color.white, size = size.tiny)
    if not na(orH) and not inOrb
        if close > orH + breakBuf
            if sendAlert("ORBU", "ORB BREAKOUT above " + fmt(orH)) and showSignals
                label.new(bar_index, low, "ORB▲", style = label.style_label_up, color = orbCol, textcolor = color.white, size = size.tiny)
        else if close < orL - breakBuf
            if sendAlert("ORBD", "ORB BREAKDOWN below " + fmt(orL)) and showSignals
                label.new(bar_index, high, "ORB▼", style = label.style_label_down, color = orbCol, textcolor = color.white, size = size.tiny)

// ───────────────────────────── Intraday layer
isIntra = timeframe.isintraday
[vw, vwUp, vwDn] = ta.vwap(hlc3, newDay, bandMult)
smallTf = isIntra and timeframe.in_seconds() <= 900
plot(showVWAP and smallTf ? vw : na, "VWAP", color = vwapCol, linewidth = 2, style = plot.style_linebr, display = display.pane)
plot(showVWAP and showBands and smallTf ? vwUp : na, "VWAP upper band", color = color.new(vwapCol, 60), style = plot.style_linebr, display = display.pane)
plot(showVWAP and showBands and smallTf ? vwDn : na, "VWAP lower band", color = color.new(vwapCol, 60), style = plot.style_linebr, display = display.pane)

var float dHi = na
var float dLo = na
if newDay
    dHi := high
    dLo := low
else
    dHi := math.max(nz(dHi, high), high)
    dLo := math.min(nz(dLo, low), low)
plot(showHL and smallTf and not newDay ? dHi : na, "Today's high", color = color.new(resCol, 40), style = plot.style_linebr, linewidth = 1, display = display.pane)
plot(showHL and smallTf and not newDay ? dLo : na, "Today's low", color = color.new(supCol, 40), style = plot.style_linebr, linewidth = 1, display = display.pane)

// Swing highs / lows on the chart's own timeframe; broken swings are removed.
var array<float> shP = array.new<float>()
var array<line>  shL = array.new<line>()
var array<label> shT = array.new<label>()
var array<float> slP = array.new<float>()
var array<line>  slL = array.new<line>()
var array<label> slT = array.new<label>()
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)
if showSwings and smallTf
    if not na(ph)
        shP.push(ph)
        shL.push(line.new(bar_index - swingLen, ph, bar_index, ph, extend = extend.right, color = swingCol, style = line.style_dotted))
        shT.push(label.new(bar_index, ph, "SH " + str.tostring(ph, "#"), style = label.style_label_left, color = swingCol, textcolor = color.white, size = size.tiny))
        if shP.size() > maxSwings
            shP.shift()
            shL.shift().delete()
            shT.shift().delete()
    if not na(pl)
        slP.push(pl)
        slL.push(line.new(bar_index - swingLen, pl, bar_index, pl, extend = extend.right, color = swingCol, style = line.style_dotted))
        slT.push(label.new(bar_index, pl, "SL " + str.tostring(pl, "#"), style = label.style_label_left, color = swingCol, textcolor = color.white, size = size.tiny))
        if slP.size() > maxSwings
            slP.shift()
            slL.shift().delete()
            slT.shift().delete()
    if barstate.isconfirmed
        if shP.size() > 0
            for i = shP.size() - 1 to 0
                if close > shP.get(i)
                    lvl = shP.get(i)
                    if swingAlerts
                        sendAlert("SHB" + str.tostring(lvl, "#"), "BROKE swing high " + fmt(lvl) + " (" + timeframe.period + "m)")
                    shP.remove(i)
                    shL.remove(i).delete()
                    shT.remove(i).delete()
        if slP.size() > 0
            for i = slP.size() - 1 to 0
                if close < slP.get(i)
                    lvl = slP.get(i)
                    if swingAlerts
                        sendAlert("SLB" + str.tostring(lvl, "#"), "BROKE swing low " + fmt(lvl) + " (" + timeframe.period + "m)")
                    slP.remove(i)
                    slL.remove(i).delete()
                    slT.remove(i).delete()
if barstate.islast
    for t in shT
        t.set_x(bar_index + 1)
    for t in slT
        t.set_x(bar_index + 1)

// VWAP cross (at most once per direction per hour)
if vwapAlerts and isIntra and barstate.isconfirmed and not na(vw)
    hr = str.tostring(hour(time, "Asia/Kolkata"))
    if close[1] <= vw[1] and close > vw + breakBuf / 2
        sendAlert("VWU" + hr, "crossed ABOVE VWAP " + fmt(vw))
    else if close[1] >= vw[1] and close < vw - breakBuf / 2
        sendAlert("VWD" + hr, "crossed BELOW VWAP " + fmt(vw))

// ───────────────────────────── Info table
var table info = table.new(position.top_right, 2, 3, bgcolor = color.new(color.white, 15), border_width = 0)
if showTable and barstate.islast
    cprType = cprWidth < 0.15 ? "NARROW · trend day likely" : cprWidth > 0.35 ? "WIDE · range day likely" : "normal"
    bias = close > tc ? "Bullish (above CPR)" : close < bc ? "Bearish (below CPR)" : "Neutral (inside CPR)"
    biasCol = close > tc ? #26a69a : close < bc ? #ef5350 : color.gray
    table.cell(info, 0, 0, "CPR", text_size = size.small, text_halign = text.align_left)
    table.cell(info, 1, 0, str.tostring(cprWidth, "#.##") + "% " + cprType, text_size = size.small, text_halign = text.align_left)
    table.cell(info, 0, 1, "Bias", text_size = size.small, text_halign = text.align_left)
    table.cell(info, 1, 1, bias, text_color = biasCol, text_size = size.small, text_halign = text.align_left)
    table.cell(info, 0, 2, "VWAP", text_size = size.small, text_halign = text.align_left)
    table.cell(info, 1, 2, na(vw) or not smallTf ? "—" : fmt(vw) + (close > vw ? "  price above" : "  price below"),
         text_color = na(vw) ? color.gray : close > vw ? #26a69a : #ef5350, text_size = size.small, text_halign = text.align_left)
